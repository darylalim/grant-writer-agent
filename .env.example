# Copy to .env and fill in. .env is gitignored.

# Required: the model provider.
ANTHROPIC_API_KEY=

# Required for funder research, and for the non-federal half of opportunity
# discovery. Omit and run with --no-search to skip. grants.gov needs no key, so
# `discover --no-search` still finds US federal opportunities.
TAVILY_API_KEY=

# Observability. Strongly recommended -- a multi-subagent run is close to
# impossible to debug from stdout alone.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=grant-writer

# Optional model overrides.
# GRANT_WRITER_DRAFTING_MODEL=anthropic:claude-opus-5-5
# GRANT_WRITER_RESEARCH_MODEL=anthropic:claude-sonnet-5-5
# GRANT_WRITER_COMPLIANCE_MODEL=anthropic:claude-sonnet-5-5
# GRANT_WRITER_GRADER_MODEL=anthropic:claude-opus-5-5
# GRANT_WRITER_DISCOVERY_MODEL=anthropic:claude-sonnet-5-5

# Optional effort overrides (low, medium, high, xhigh, max).
# GRANT_WRITER_DRAFTING_EFFORT=high
# GRANT_WRITER_RESEARCH_EFFORT=high
# GRANT_WRITER_COMPLIANCE_EFFORT=high
# GRANT_WRITER_GRADER_EFFORT=high
# GRANT_WRITER_DISCOVERY_EFFORT=medium

# Deployments only: Postgres for checkpoints and the Store. Unset means SQLite
# (CLI) and memory. Run `grant-writer db-setup` once per deploy.
# DATABASE_URL=postgresql://user:password@host:5432/grant_writer
# GRANT_WRITER_DB_POOL_MAX_SIZE=10
# GRANT_WRITER_DB_POOL_TIMEOUT=30

# Limits for signed-in users of the web UI (sign-in is configured in
# .streamlit/secrets.toml, not here). Estimated spend per user per UTC day,
# turns in flight at once across the deployment, and one web search's cost.
# GRANT_WRITER_DAILY_BUDGET_USD=10
# GRANT_WRITER_MAX_CONCURRENT_RUNS=3
# GRANT_WRITER_SEARCH_COST_USD=0.008
