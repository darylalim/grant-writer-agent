# Copy to .env and fill in. .env is gitignored.

# Required: the model provider.
ANTHROPIC_API_KEY=

# Required for funder research. Omit and run with --no-search to skip.
TAVILY_API_KEY=

# Observability. Strongly recommended -- a multi-subagent run is close to
# impossible to debug from stdout alone.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=grant-writer

# Optional model overrides.
# GRANT_WRITER_DRAFTING_MODEL=anthropic:claude-opus-5
# GRANT_WRITER_RESEARCH_MODEL=anthropic:claude-sonnet-5
# GRANT_WRITER_COMPLIANCE_MODEL=anthropic:claude-sonnet-5
# GRANT_WRITER_GRADER_MODEL=anthropic:claude-sonnet-5
